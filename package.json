{
  "name": "prabh-map-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "prebuild:vercel": "node scripts/build-private-atlas-shards.mjs --check",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "data:atlas-runtime": "node scripts/build-private-atlas-shards.mjs",
    "check:atlas-runtime": "node scripts/check-private-atlas-runtime.mjs && node scripts/check-private-atlas-deployment.mjs",
    "preview:vercel": "vite preview --config vite.vercel.config.ts",
    "check:private-atlas": "node scripts/check-private-atlas.mjs",
    "check:northern-review": "npm run check:united-punjab",
    "check:northern-review-browser": "npm run check:united-punjab-browser",
    "check:private-atlas-browser": "node scripts/verify-private-atlas-browser.mjs",
    "check:punjab-division-profiles-browser": "node scripts/verify-punjab-division-profiles.mjs",
    "data:punjab-district-profiles": "node scripts/build-punjab-district-profiles.mjs",
    "check:punjab-district-profiles": "node scripts/check-punjab-district-profiles.mjs",
    "check:punjab-district-profiles-browser": "node scripts/verify-punjab-district-profiles.mjs",
    "check:punjab-rankings-browser": "node scripts/verify-punjab-rankings.mjs",
    "check:boundaries": "node scripts/check-indian-regions.mjs && node scripts/check-kashmir-view.mjs && node scripts/check-delhi-layers.mjs && node scripts/check-neighbour-countries.mjs && node scripts/check-pakistan-divisions.mjs",
    "check:atlas": "node scripts/check-map-scopes.mjs && node scripts/check-atlas-overlays.mjs && node scripts/check-gurdwaras.mjs && node scripts/check-gurdwara-directory.mjs",
    "check:atlas-browser": "node scripts/verify-atlas-presets.mjs",
    "check:workspace-browser": "node scripts/verify-workspace-ui.mjs",
    "check:gurdwara-photos": "node scripts/check-gurdwara-photos.mjs",
    "check:pakistan-browser": "node scripts/verify-pakistan-divisions.mjs",
    "data:pakistan-divisions": "node scripts/build-pakistan-divisions.mjs",
    "data:atlas-overlays": "node scripts/build-atlas-overlays.mjs",
    "data:gurdwaras": "node scripts/build-gurdwaras.mjs",
    "data:neighbour-countries": "node scripts/import-neighbour-countries.mjs",
    "data:tibet-context": "node scripts/build-tibet-context.mjs && node scripts/build-modern-tibet-view.mjs",
    "check:countries-browser": "node scripts/verify-country-layers.mjs",
    "data:indian-regions": "node scripts/import-indian-regions.mjs",
    "data:kashmir-view": "node scripts/build-kashmir-view.mjs",
    "data:delhi": "node scripts/build-delhi-wards.mjs && node scripts/build-delhi-ncr.mjs && node scripts/build-delhi-metro.mjs",
    "check:delhi-browser": "node scripts/verify-delhi-browser.mjs",
    "check:browser": "node scripts/verify-map-browser.mjs",
    "check:states-browser": "node scripts/verify-state-layers.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "check:nature": "node scripts/check-nature.mjs",
    "check:gurdwara-directory": "node scripts/check-gurdwara-directory.mjs",
    "data:gurdwara-directory": "node scripts/build-gurdwara-directory.mjs",
    "check:demographics": "node scripts/check-demographics.mjs",
    "check:demographics-browser": "node scripts/verify-demographics-browser.mjs",
    "check:history-religion": "node scripts/check-history-religion.mjs",
    "check:history-religion-browser": "node scripts/verify-history-religion-browser.mjs",
    "check:case-study": "node scripts/check-case-study.mjs",
    "check:case-study-browser": "node scripts/verify-case-study-browser.mjs",
    "check:visibility": "node scripts/check-area-visibility.mjs",
    "check:visibility-browser": "node scripts/verify-area-visibility-browser.mjs",
    "check:custom-maps": "node scripts/check-custom-maps.mjs",
    "check:custom-maps-browser": "node scripts/verify-custom-maps-browser.mjs",
    "data:punjab-seams": "python scripts/build-punjab-seams.py",
    "check:punjab-seams": "node scripts/check-punjab-seams.mjs",
    "check:punjab-seams-browser": "node scripts/verify-punjab-seams-browser.mjs",
    "check:map-navigation": "node scripts/check-map-navigation.mjs",
    "check:map-navigation-browser": "node scripts/verify-map-navigation-browser.mjs",
    "check:paint-palette": "node scripts/check-paint-palette.mjs",
    "check:paint-palette-browser": "node scripts/verify-paint-palette-browser.mjs",
    "check:paint-interactions-browser": "node scripts/verify-paint-interactions-browser.mjs",
    "data:united-punjab": "node scripts/run-atlas-python.mjs apply-united-punjab-reorganization.py && node scripts/prepare-punjab-population.mjs && node scripts/run-atlas-python.mjs finalize-punjab-divisions.py && node scripts/run-atlas-python.mjs apply-punjab-historical-regions.py && npm run data:punjab-demographics",
    "check:united-punjab": "node scripts/run-atlas-python.mjs check-united-punjab-geometry.py && npm run check:private-atlas",
    "check:united-punjab-browser": "node scripts/verify-united-punjab-browser.mjs",
    "data:punjab-environment": "node scripts/prepare-punjab-population.mjs && node scripts/run-atlas-python.mjs estimate-punjab-environment.py",
    "check:punjab-final-divisions": "node scripts/run-atlas-python.mjs check-punjab-final-divisions.py && npm run check:private-atlas",
    "check:punjab-final-divisions-browser": "node scripts/verify-punjab-final-divisions.mjs",
    "data:punjab-historical-regions": "node scripts/run-atlas-python.mjs apply-punjab-historical-regions.py && npm run data:punjab-demographics",
    "check:punjab-historical-regions": "node scripts/run-atlas-python.mjs check-punjab-historical-regions.py && npm run check:private-atlas",
    "check:punjab-historical-regions-browser": "node scripts/verify-punjab-historical-regions.mjs",
    "data:punjab-demographics": "node scripts/run-atlas-python.mjs prepare-punjab-demographics.py && node scripts/build-punjab-demographics.mjs && node scripts/run-atlas-python.mjs apply-punjab-demographics.py && node scripts/pack-private-atlas.mjs",
    "check:punjab-demographics": "node scripts/run-atlas-python.mjs check-punjab-demographic-geometry.py && npm run check:private-atlas",
    "check:punjab-demographics-browser": "node scripts/verify-punjab-demographics.mjs",
    "export:punjab-pdf": "node scripts/export-punjab-atlas-pdf.mjs",
    "check:punjab-pdf-browser": "node scripts/verify-punjab-pdf.mjs",
    "check:world-map": "node scripts/check-world-map.mjs",
    "check:world-map-browser": "node scripts/verify-world-map.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "^6.7.0",
    "pdf-lib": "1.17.1",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.64.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "Open-source South Asia mapping software for research, developed and created by Prabhmannat Singh.",
  "author": "Prabhmannat Singh (Prabh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PRABHMANNAT/Historic-Panjab.git"
  }
}
